{# Modal fragment for creating an annonce in admin #}
<div class="modal-header">
  <h5 class="modal-title">Créer une Annonce</h5>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
  {{ form_start(form, {'attr': {'id': 'admin-annonce-form'}}) }}
  <div class="row g-3">
    <div class="col-md-6">
      {{ form_label(form.titre) }}
      {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="col-md-6">
      {{ form_label(form.voiture) }}
      {{ form_widget(form.voiture, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="col-12">
      {{ form_label(form.description) }}
      {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
    </div>
  </div>
  {{ form_end(form) }}
</div>
<div class="modal-footer">
  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
  <button type="button" id="admin-annonce-submit" class="btn btn-primary">Créer</button>
</div>
