<div class="modal-header">
    <h5 class="modal-title">Ajouter une voiture</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'id': 'admin-voiture-form'}}) }}
    <div class="row g-3">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.marque) }}
                {{ form_widget(form.marque, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.modele) }}
                {{ form_widget(form.modele, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.annee) }}
                {{ form_widget(form.annee, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.prix) }}
                {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.puissance_fiscale) }}
                {{ form_widget(form.puissance_fiscale, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.kilometrage) }}
                {{ form_widget(form.kilometrage, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.boite_vitesse) }}
                {{ form_widget(form.boite_vitesse, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.carburant) }}
                {{ form_widget(form.carburant, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.cylindree) }}
                {{ form_widget(form.cylindree, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.nombre_portes) }}
                {{ form_widget(form.nombre_portes, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                {{ form_label(form.image) }}
                {{ form_widget(form.image, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
<script src="{{ asset('js/form-validator.js') }}"></script>
<script>
  initFormValidation('#admin-voiture-form', {
    marque: { required: true, minLength: 2, messages: { required: 'Marque requise', minLength: 'Au moins 2 caractères' } },
    modele: { required: true },
    annee: { required: true, pattern: '^[0-9]{4}$', messages: { pattern: 'Entrez une année valide' } },
    prix: { required: true, min: 0 },
    puissance_fiscale: { required: true, min: 1 },
    kilometrage: { required: true, min: 0 },
    boite_vitesse: { required: true },
    carburant: { required: true }
  });
</script>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
    <button type="submit" form="admin-voiture-form" id="admin-voiture-submit" class="btn btn-primary">Ajouter</button>
</div>
{# Form validation is loaded globally through app.js #}
