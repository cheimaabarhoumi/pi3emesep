{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_title %}Dashboard{% endblock %}
{% block page_heading %}Dashboard Overview{% endblock %}

{% block body %}
<div class="d-flex">
    {% include 'admin/sidebar.html.twig' %}
    <div class="flex-grow-1 px-4 py-4">
        <div class="container py-5">
    <h2 class="mb-4">Statistiques Voitures & Annonces</h2>
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow border-0 bg-gradient-info text-white mb-3">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-car fa-2x me-3"></i>
                    <div>
                        <h6 class="mb-1">Total Voitures</h6>
                        <h3 class="mb-0">{{ voitures|length }}</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 bg-gradient-primary text-white mb-3">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-bullhorn fa-2x me-3"></i>
                    <div>
                        <h6 class="mb-1">Total Annonces</h6>
                        <h3 class="mb-0">{{ annonces|length }}</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 bg-gradient-success text-white mb-3">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-calendar-alt fa-2x me-3"></i>
                    <div>
                        <h6 class="mb-1">Année la plus récente</h6>
                        <h3 class="mb-0">
                            {% set max_annee = 0 %}
                            {% for voiture in voitures %}
                                {% if voiture.annee > max_annee %}
                                    {% set max_annee = voiture.annee %}
                                {% endif %}
                            {% endfor %}
                            {{ max_annee > 0 ? max_annee : 'N/A' }}
                        </h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 bg-gradient-warning text-white mb-3">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-star fa-2x me-3"></i>
                    <div>
                        <h6 class="mb-1">Voiture la plus chère</h6>
                        <h3 class="mb-0">
                            {% set max_voiture = null %}
                            {% for voiture in voitures %}
                                {% if max_voiture is null or voiture.prix > max_voiture.prix %}
                                    {% set max_voiture = voiture %}
                                {% endif %}
                            {% endfor %}
                            {{ max_voiture ? max_voiture.marque ~ ' ' ~ max_voiture.modele ~ ' (' ~ max_voiture.prix ~ ' TND)' : 'N/A' }}
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow border-0 mb-3">
                <div class="card-header bg-info text-white">Voitures récentes</div>
                <ul class="list-group list-group-flush">
                    {% for voiture in voitures|slice(0,5) %}
                        <li class="list-group-item">{{ voiture.marque }} {{ voiture.modele }} - {{ voiture.annee }}</li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucune voiture</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow border-0 mb-3">
                <div class="card-header bg-primary text-white">Annonces récentes</div>
                <ul class="list-group list-group-flush">
                    {% for annonce in annonces|slice(0,5) %}
                        <li class="list-group-item">{{ annonce.titre }} - {{ annonce.voiture.marque }} {{ annonce.voiture.modele }}</li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucune annonce</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow border-0 mb-3">
                <div class="card-header bg-gradient-success text-white">Répartition des voitures par année</div>
                <div class="card-body">
                    <canvas id="voitureYearChart" height="120"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow border-0 mb-3">
                <div class="card-header bg-gradient-primary text-white">Aperçu graphique (barres)</div>
                <div class="card-body">
                    <canvas id="statsChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-end">
            <a href="{{ path('gestion_voiture') }}" class="btn btn-info me-2"><i class="fas fa-plus"></i> Ajouter une Voiture</a>
            <a href="{{ path('gestion_annonce') }}" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter une Annonce</a>
        </div>
    </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Bar chart for total voitures/annonces
    var ctx = document.getElementById('statsChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Voitures', 'Annonces'],
            datasets: [{
                label: 'Total',
                data: [{{ voitures|length }}, {{ annonces|length }}],
                backgroundColor: ['#17a2b8', '#007bff']
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } }
        }
    });

    // Pie chart for voiture years
    var yearCounts = {};
    {% for voiture in voitures %}
        yearCounts['{{ voiture.annee }}'] = (yearCounts['{{ voiture.annee }}'] || 0) + 1;
    {% endfor %}
    var yearLabels = Object.keys(yearCounts);
    var yearData = Object.values(yearCounts);
    var yearColors = yearLabels.map((_,i) => `hsl(${i*40},70%,60%)`);
    var ctxYear = document.getElementById('voitureYearChart').getContext('2d');
    new Chart(ctxYear, {
        type: 'pie',
        data: {
            labels: yearLabels,
            datasets: [{
                label: 'Voitures par année',
                data: yearData,
                backgroundColor: yearColors
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });
});
</script>




{% endblock %} 
{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const input = document.getElementById('search-input');
        const resultsContainer = document.getElementById('contrat-results');

        input.addEventListener('input', function () {
            const query = input.value;

            fetch(`/admin/search?q=${encodeURIComponent(query)}`)
                .then(response => response.text())
                .then(html => {
                    resultsContainer.innerHTML = html;
                })
                .catch(err => {
                    console.error('Erreur AJAX :', err);
                });
        });
    });
    </script>
{% endblock %}
