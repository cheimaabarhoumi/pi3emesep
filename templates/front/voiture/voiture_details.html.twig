{% extends 'front/base.html.twig' %}

{% block title %}{{ voiture.marque }} {{ voiture.modele }} - Neo Cars{% endblock %}

{% block content %}
<section id="voiture-details" class="py-5" style="background: linear-gradient(135deg, #fafdff 0%, #e9ecef 100%); min-height: 100vh; position: relative;">
    <!-- Subtle Animated Background Elements -->
    <div class="animated-bg">
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
        <div class="floating-shape shape-4"></div>
    </div>

    <div class="container position-relative">
        <!-- Enhanced Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <div class="breadcrumb-container">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_voiture') }}" class="breadcrumb-link">
                            <i class="fas fa-home me-2"></i>Voitures
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="fas fa-car me-2"></i>{{ voiture.marque }} {{ voiture.modele }}
                    </li>
                </ol>
            </div>
        </nav>

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Hero Section -->
                <div class="voiture-hero mb-4">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden position-relative voiture-details-main-card">
                        {% if voiture.image %}
                            <div class="hero-image-container position-relative">
                                <img src="{{ asset('uploads/' ~ voiture.image) }}"
                                     alt="{{ voiture.marque }} {{ voiture.modele }}"
                                     class="hero-image">
                                
                                <!-- Enhanced Floating Badges -->
                                {% if voiture.prix %}
                                    <div class="floating-badge price-badge">
                                        <div class="badge-content price-content">
                                            <i class="fas fa-tag me-2"></i>
                                            <span class="price-amount">{{ voiture.prix }}</span>
                                            <small class="currency">TND</small>
                                        </div>
                                    </div>
                                {% endif %}
                                
                                {% if voiture.annee %}
                                    <div class="floating-badge year-badge">
                                        <div class="badge-content year-content">
                                            <i class="fas fa-calendar me-2"></i>
                                            {{ voiture.annee }}
                                        </div>
                                    </div>
                                {% endif %}

                                <!-- Premium Badge -->
                                {% if voiture.prix and voiture.prix > 50000 %}
                                    <div class="premium-badge">
                                        <i class="fas fa-crown me-2"></i>
                                        <span>Premium</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="no-image-hero d-flex align-items-center justify-content-center">
                                <div class="text-center">
                                    <div class="no-image-icon mb-3">
                                        <i class="fas fa-car fa-5x text-muted"></i>
                                    </div>
                                    <h4 class="text-muted">Aucune image disponible</h4>
                                </div>
                            </div>
                        {% endif %}
                        
                        <!-- Enhanced Hero Info -->
                        <div class="hero-info p-4" style="background: linear-gradient(135deg, #fafdff 0%, #e9ecef 100%); color: #23272f; border-top: 1px solid #e9ecef;">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h1 class="display-4 fw-bold mb-2" style="color: #23272f; text-shadow: 0 2px 8px rgba(0,0,0,0.07);">
                                        {{ voiture.marque }} {{ voiture.modele }}
                                    </h1>
                                    <p class="lead text-secondary mb-0" style="font-size: 1.15rem;">
                                        {% if voiture.annee %}Année {{ voiture.annee }}{% endif %}
                                        {% if voiture.kilometrage %} • {{ voiture.kilometrage }} km{% endif %}
                                        {% if voiture.puissanceFiscale %} • {{ voiture.puissanceFiscale }} CV{% endif %}
                                    </p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <div class="voiture-actions d-flex flex-column flex-md-row gap-2 mt-auto">
                                        <a href="{{ path('edit_voiture', {id: voiture.id}) }}" 
                                           class="btn btn-warning btn-sm w-100 action-btn d-flex align-items-center justify-content-center gap-1">
                                            <i class="fas fa-edit"></i>Modifier
                                        </a>
                                        <form method="post" action="{{ path('voiture_delete', {id: voiture.id}) }}" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette voiture ?');" 
                                              class="d-inline w-100">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
                                            <button class="btn btn-danger btn-sm w-100 action-btn d-flex align-items-center justify-content-center gap-1" type="submit">
                                                <i class="fas fa-trash"></i>Supprimer
                                            </button>
                                        </form>
                                        <a href="{{ path('create_annonce', {voitureId: voiture.id}) }}" 
                                           class="btn btn-success btn-sm action-btn w-100 d-flex align-items-center justify-content-center gap-1">
                                            <i class="fas fa-plus"></i>Créer une annonce
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Enhanced Specifications Grid -->
                <div class="specifications-section mb-4">
                    <div class="card border-0 shadow-lg rounded-4">
                        <div class="card-header bg-white text-primary rounded-top-4" style="border-bottom: 1.5px solid #e9ecef;">
                            <h3 class="h4 mb-0" style="font-weight:700;">
                                <i class="fas fa-cogs me-2"></i>Spécifications techniques
                            </h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-12 col-md-6">
                                    <div class="spec-item enhanced d-flex align-items-center gap-3" style="background: #fafdff;">
                                        <div class="spec-icon bg-light border border-2 border-primary-subtle">
                                            <i class="fas fa-tachometer-alt text-primary"></i>
                                        </div>
                                        <div class="spec-content">
                                            <h6 class="spec-label">Kilométrage</h6>
                                            <p class="spec-value">{{ voiture.kilometrage ? voiture.kilometrage ~ ' km' : 'Non spécifié' }}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="spec-item enhanced d-flex align-items-center gap-3" style="background: #fafdff;">
                                        <div class="spec-icon bg-light border border-2 border-warning-subtle">
                                            <i class="fas fa-bolt text-warning"></i>
                                        </div>
                                        <div class="spec-content">
                                            <h6 class="spec-label">Puissance fiscale</h6>
                                            <p class="spec-value">{{ voiture.puissanceFiscale ? voiture.puissanceFiscale ~ ' CV' : 'Non spécifié' }}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="spec-item enhanced d-flex align-items-center gap-3" style="background: #fafdff;">
                                        <div class="spec-icon bg-light border border-2 border-info-subtle">
                                            <i class="fas fa-cog text-info"></i>
                                        </div>
                                        <div class="spec-content">
                                            <h6 class="spec-label">Boîte de vitesse</h6>
                                            <p class="spec-value">{{ voiture.boiteVitesse ?: 'Non spécifié' }}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="spec-item enhanced d-flex align-items-center gap-3" style="background: #fafdff;">
                                        <div class="spec-icon bg-light border border-2 border-success-subtle">
                                            <i class="fas fa-gas-pump text-success"></i>
                                        </div>
                                        <div class="spec-content">
                                            <h6 class="spec-label">Carburant</h6>
                                            <p class="spec-value">{{ voiture.carburant ?: 'Non spécifié' }}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="spec-item enhanced d-flex align-items-center gap-3" style="background: #fafdff;">
                                        <div class="spec-icon bg-light border border-2 border-danger-subtle">
                                            <i class="fas fa-industry text-danger"></i>
                                        </div>
                                        <div class="spec-content">
                                            <h6 class="spec-label">Cylindrée</h6>
                                            <p class="spec-value">{{ voiture.cylindree ?: 'Non spécifié' }}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="spec-item enhanced d-flex align-items-center gap-3" style="background: #fafdff;">
                                        <div class="spec-icon bg-light border border-2 border-secondary-subtle">
                                            <i class="fas fa-door-open text-secondary"></i>
                                        </div>
                                        <div class="spec-content">
                                            <h6 class="spec-label">Nombre de portes</h6>
                                            <p class="spec-value">{{ voiture.nombrePortes ?: 'Non spécifié' }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enhanced Sidebar -->
            <div class="col-lg-4">
                <!-- Quick Actions Card -->
                <div class="quick-actions-card mb-4">
                    <div class="card border-0 shadow-lg rounded-4">
                        <div class="card-header bg-white text-primary rounded-top-4" style="border-bottom: 1.5px solid #e9ecef;">
                            <h4 class="h5 mb-0">
                                <i class="fas fa-tools me-2"></i>Actions rapides
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-grid gap-2">
                                <a href="{{ path('edit_voiture', { id: voiture.id }) }}" class="btn btn-action btn-lg w-100">
                                    <i class="fas fa-edit me-2"></i>Modifier
                                </a>
                                <a href="{{ path('create_annonce', {voitureId: voiture.id}) }}" class="btn btn-action btn-lg w-100 btn-success">
                                    <i class="fas fa-plus me-2"></i>Créer une annonce
                                </a>
                                <form action="{{ path('voiture_delete', {id: voiture.id}) }}" method="post" class="w-100" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette voiture ?');">
                                    <button type="submit" class="btn btn-action btn-lg w-100 btn-delete">
                                        <i class="fas fa-trash me-2"></i>Supprimer
                                    </button>
                                </form>
                                <a href="{{ path('app_voiture') }}" class="btn btn-action btn-lg w-100 btn-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Retourner
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Enhanced Vehicle Summary Card -->
                <div class="vehicle-summary-card">
                    <div class="card border-0 shadow-lg rounded-4">
                        <div class="card-header bg-gradient-info text-white rounded-top-4">
                            <h4 class="h5 mb-0">
                                <i class="fas fa-info-circle me-2"></i>Résumé du véhicule
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <div class="summary-item d-flex justify-content-between align-items-center mb-3">
                                <span class="summary-label">
                                    <i class="fas fa-car me-2 text-primary"></i>Marque
                                </span>
                                <span class="summary-value fw-bold">{{ voiture.marque }}</span>
                            </div>
                            <div class="summary-item d-flex justify-content-between align-items-center mb-3">
                                <span class="summary-label">
                                    <i class="fas fa-tag me-2 text-info"></i>Modèle
                                </span>
                                <span class="summary-value fw-bold">{{ voiture.modele }}</span>
                            </div>
                            <div class="summary-item d-flex justify-content-between align-items-center mb-3">
                                <span class="summary-label">
                                    <i class="fas fa-calendar me-2 text-warning"></i>Année
                                </span>
                                <span class="summary-value fw-bold">{{ voiture.annee ?: 'Non spécifié' }}</span>
                            </div>
                            <div class="summary-item d-flex justify-content-between align-items-center mb-3">
                                <span class="summary-label">
                                    <i class="fas fa-tag me-2 text-success"></i>Prix
                                </span>
                                <span class="summary-value fw-bold text-primary">{{ voiture.prix ? voiture.prix ~ ' TND' : 'Non spécifié' }}</span>
                            </div>
                            <div class="summary-item d-flex justify-content-between align-items-center">
                                <span class="summary-label">
                                    <i class="fas fa-tachometer-alt me-2 text-danger"></i>Kilométrage
                                </span>
                                <span class="summary-value fw-bold">{{ voiture.kilometrage ? voiture.kilometrage ~ ' km' : 'Non spécifié' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.btn-action {
    background: #fafdff;
    color: #23272f;
    border: 1.5px solid #e9ecef;
    border-radius: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    box-shadow: 0 2px 8px rgba(36, 37, 42, 0.06);
    transition: box-shadow 0.25s, transform 0.25s, background 0.25s, color 0.25s, border-color 0.25s;
    position: relative;
    overflow: hidden;
    padding: 1rem 1.5rem;
    cursor: pointer;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}
.btn-action:active,
.btn-action:focus {
    outline: 2px solid #4e8cff;
}
.btn-action:hover {
    background: #e9ecef;
    color: #23272f;
    border-color: #4e8cff;
    box-shadow: 0 8px 24px #4e8cff22;
    transform: translateY(-2px) scale(1.02);
}
.btn-action.btn-success {
    background: #e6f9f0;
    color: #198754;
    border-color: #b2f7ef;
}
.btn-action.btn-success:hover {
    background: #b2f7ef;
    color: #198754;
    border-color: #20c997;
}
.btn-action.btn-delete {
    background: #fff0f0;
    color: #dc3545;
    border-color: #f5c2c7;
}
.btn-action.btn-delete:hover {
    background: #f5c2c7;
    color: #fff;
    border-color: #dc3545;
}
.btn-action.btn-secondary {
    background: #f5f7fa;
    color: #495057;
    border-color: #e9ecef;
}
.btn-action.btn-secondary:hover {
    background: #e9ecef;
    color: #23272f;
    border-color: #adb5bd;
}
.btn-futuristic {
    background: linear-gradient(90deg,#00c3ff,#ffff1c);
    color: #23272f;
    border: none;
    border-radius: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    box-shadow: 0 2px 16px rgba(0,255,255,0.08), 0 1.5px 4px rgba(32,201,151,0.04);
    transition: box-shadow 0.35s, transform 0.35s, background 0.35s, color 0.35s;
    position: relative;
    overflow: hidden;
    padding: 1rem 1.5rem;
    cursor: pointer;
    outline: none;
}
.btn-futuristic:active,
.btn-futuristic:focus {
    outline: 2px solid #00c3ff;
}
.btn-futuristic:hover {
    background: linear-gradient(90deg,#ffff1c,#00c3ff);
    color: #23272f;
    box-shadow: 0 8px 32px #00c3ff44;
    transform: translateY(-3px) scale(1.03);
}
/* Subtle Animated Background */
.animated-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
}

.floating-shape {
    position: absolute;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 50%;
    animation: float 15s ease-in-out infinite;
}

.shape-1 {
    width: 140px;
    height: 140px;
    top: 15%;
    left: 8%;
    animation-delay: 0s;
}

.shape-2 {
    width: 200px;
    height: 200px;
    top: 55%;
    right: 12%;
    animation-delay: 5s;
}

.shape-3 {
    width: 120px;
    height: 120px;
    bottom: 25%;
    left: 15%;
    animation-delay: 10s;
}

.shape-4 {
    width: 160px;
    height: 160px;
    top: 75%;
    left: 60%;
    animation-delay: 7s;
}

@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); opacity: 0.04; }
    50% { transform: translateY(-20px) rotate(90deg) scale(1.05); opacity: 0.08; }
}

/* Enhanced Breadcrumb */
.breadcrumb-container {
    background: rgba(255, 255, 255, 0.95);
    padding: 1.5rem;
    border-radius: 1.5rem;
    backdrop-filter: blur(30px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.4s ease;
}

.breadcrumb-container:hover {
    background: rgba(255, 255, 255, 1);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.12);
}

.breadcrumb {
    background: transparent;
    margin: 0;
    padding: 0;
}

.breadcrumb-item a {
    color: #667eea;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.4s ease;
    position: relative;
}

.breadcrumb-item a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #667eea, #764ba2);
    transition: width 0.4s ease;
}

.breadcrumb-item a:hover::after {
    width: 100%;
}

.breadcrumb-item a:hover {
    color: #764ba2;
    transform: translateX(8px);
}

.breadcrumb-item.active {
    color: #6c757d;
}

/* Enhanced Hero Section */
.voiture-hero {
    position: relative;
}

.hero-image-container {
    height: 500px;
    overflow: hidden;
    position: relative;
}

.hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.voiture-hero:hover .hero-image {
    transform: scale(1.08);
}

.no-image-hero {
    height: 500px;
    background: linear-gradient(45deg, #f8f9fa 25%, #e9ecef 25%, #e9ecef 50%, #f8f9fa 50%, #f8f9fa 75%, #e9ecef 75%, #e9ecef);
    background-size: 30px 30px;
    animation: move 35s linear infinite;
}

@keyframes move {
    0% { background-position: 0 0; }
    100% { background-position: 60px 60px; }
}

.no-image-icon {
    animation: bounce 3.5s infinite;
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-18px); }
    60% { transform: translateY(-9px); }
}

/* Enhanced Floating Badges */
.floating-badge {
    position: absolute;
    z-index: 15;
}

.price-badge {
    top: 30px;
    right: 30px;
}

.year-badge {
    top: 30px;
    right: 30px;
    margin-top: 90px;
}

.badge-content {
    background: rgba(0, 0, 0, 0.9);
    color: white;
    padding: 1.2rem 2rem;
    border-radius: 3.5rem;
    backdrop-filter: blur(30px);
    font-weight: 700;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

.badge-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.8s;
}

.badge-content:hover::before {
    left: 100%;
}

.badge-content:hover {
    transform: scale(1.1);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
}

.price-content {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.9), rgba(40, 167, 69, 0.8));
    border-color: rgba(40, 167, 69, 0.6);
}

.year-content {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.9), rgba(255, 193, 7, 0.8));
    border-color: rgba(255, 193, 7, 0.6);
}

.price-amount {
    font-size: 1.3rem;
    color: #ffd700;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.6);
}

.currency {
    font-size: 1rem;
    opacity: 0.9;
}

/* Premium Badge */
.premium-badge {
    position: absolute;
    top: 30px;
    left: 30px;
    background: linear-gradient(135deg, #ffd700, #ffed4e, #ffd700);
    color: #8b4513;
    padding: 1rem 2rem;
    border-radius: 3.5rem;
    font-weight: bold;
    font-size: 0.95rem;
    z-index: 15;
    box-shadow: 0 12px 35px rgba(255, 215, 0, 0.4);
    animation: premiumPulse 4s infinite;
    border: 2px solid rgba(255, 255, 255, 0.4);
    position: relative;
    overflow: hidden;
}

.premium-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.8s;
}

.premium-badge:hover::before {
    left: 100%;
}

@keyframes premiumPulse {
    0% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.1) rotate(4deg); }
    100% { transform: scale(1) rotate(0deg); }
}

/* Enhanced Hero Info */
.hero-info {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    position: relative;
    overflow: hidden;
}

.hero-info::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.08"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.08"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.08"/><circle cx="10" cy="60" r="0.5" fill="white" opacity="0.08"/><circle cx="90" cy="40" r="0.5" fill="white" opacity="0.08"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.4;
}

.hero-info > * {
    position: relative;
    z-index: 2;
}

/* Enhanced Action Buttons */
.action-btn {
    border-radius: 1.2rem;
    font-weight: 700;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: none;
    position: relative;
    overflow: hidden;
