{% extends 'front/base.html.twig' %}

{% block title %}{{ voiture.marque }} {{ voiture.modele }} - NeoCarVilla{% endblock %}

{% block content %}
<!-- Enhanced Neo Breadcrumb Section -->
<section class="neo-section py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin-top: 80px; position: relative; overflow: hidden;">
    <!-- Animated Background Particles -->
    <div class="particles-bg">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>
    
    <div class="neo-container position-relative">
        <nav aria-label="breadcrumb" class="neo-animate-on-scroll">
            <div class="modern-breadcrumb p-4 rounded-4">
                <ol class="breadcrumb mb-0 d-flex align-items-center">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_voiture') }}" class="breadcrumb-link">
                            <i class="fas fa-home me-2"></i>Voitures
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        <i class="fas fa-car me-2"></i>{{ voiture.marque }} {{ voiture.modele }}
                    </li>
                </ol>
            </div>
        </nav>
        
        <!-- Hero Title Section -->
        <div class="hero-title-section text-center text-white mt-4 neo-animate-on-scroll" style="animation-delay: 0.2s;">
            <h1 class="display-3 fw-bold mb-3" style="text-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                {{ voiture.marque }} {{ voiture.modele }}
            </h1>
            {% if voiture.prix %}
                <div class="price-highlight d-inline-block px-4 py-2 rounded-pill" 
                     style="background: rgba(255,255,255,0.2); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.3);">
                    <span class="h3 mb-0 fw-bold">{{ voiture.prix|number_format(0, ',', ' ') }} TND</span>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<!-- Enhanced Neo Car Details Section -->
<section class="neo-section py-5" style="background: linear-gradient(to bottom, #f8fafc 0%, #e2e8f0 100%);">
    <div class="neo-container">
        <div class="row g-5">
            <!-- Main Image & Gallery -->
            <div class="col-lg-8">
                <div class="neo-animate-on-scroll">
                    <!-- Enhanced Main Image Display -->
                    <div class="image-showcase-card neo-card overflow-hidden mb-5 position-relative">
                        {% if voiture.image %}
                            <div class="position-relative image-container">
                                <img src="{{ asset('uploads/' ~ voiture.image) }}" 
                                     alt="{{ voiture.marque }} {{ voiture.modele }}"
                                     class="showcase-image w-100"
                                     style="height: 550px; object-fit: cover;"
                                     id="mainCarImage">
                                
                                <!-- Enhanced Status Badges -->
                                <div class="position-absolute top-0 start-0 m-4 badge-container">
                                    <span class="status-badge available-badge">
                                        <i class="fas fa-check-circle me-2"></i>Disponible
                                    </span>
                                </div>
                                
                                <!-- Enhanced Premium Badge -->
                                {% if voiture.prix and voiture.prix > 50000 %}
                                    <div class="position-absolute top-0 end-0 m-4">
                                        <span class="premium-badge-enhanced">
                                            <i class="fas fa-crown me-2"></i>Premium
                                        </span>
                                    </div>
                                {% endif %}
                                
                                <!-- Enhanced Zoom Overlay -->
                                <div class="zoom-overlay-enhanced position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                    <div class="zoom-button">
                                        <i class="fas fa-search-plus fa-2x"></i>
                                        <span class="d-block mt-2">Cliquer pour agrandir</span>
                                    </div>
                                </div>
                                
                                <!-- Image Counter -->
                                <div class="position-absolute bottom-0 end-0 m-4">
                                    <span class="image-counter">
                                        <i class="fas fa-images me-2"></i>1 / 1
                                    </span>
                                </div>
                            </div>
                        {% else %}
                            <div class="no-image-placeholder w-100 d-flex align-items-center justify-content-center" 
                                 style="height: 550px;">
                                <div class="text-center">
                                    <div class="no-image-icon-enhanced mb-4">
                                        <i class="fas fa-car fa-6x"></i>
                                    </div>
                                    <h4 class="text-muted mb-2">Aucune image disponible</h4>
                                    <p class="text-muted mb-0">L'image sera ajoutée prochainement</p>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- Enhanced Vehicle Info Cards -->
                    <div class="vehicle-info-grid mb-5">
                        <div class="row g-4">
                            <!-- Main Info Card -->
                            <div class="col-12">
                                <div class="main-info-card neo-card p-4">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start">
                                        <div class="vehicle-title-section flex-grow-1">
                                            <div class="brand-model-badge mb-3">
                                                <span class="brand-badge">{{ voiture.marque }}</span>
                                                <span class="model-badge">{{ voiture.modele }}</span>
                                            </div>
                                            <p class="vehicle-specs mb-0">
                                                {% if voiture.annee %}
                                                    <span class="spec-item">
                                                        <i class="fas fa-calendar text-primary me-2"></i>
                                                        <strong>{{ voiture.annee }}</strong>
                                                    </span>
                                                {% endif %}
                                                {% if voiture.kilometrage %}
                                                    <span class="spec-item">
                                                        <i class="fas fa-tachometer-alt text-warning me-2"></i>
                                                        <strong>{{ voiture.kilometrage|number_format(0, ',', ' ') }} km</strong>
                                                    </span>
                                                {% endif %}
                                                {% if voiture.puissanceFiscale %}
                                                    <span class="spec-item">
                                                        <i class="fas fa-bolt text-success me-2"></i>
                                                        <strong>{{ voiture.puissanceFiscale }} CV</strong>
                                                    </span>
                                                {% endif %}
                                            </p>
                                        </div>
                                        {% if not voiture.prix %}
                                            <div class="price-section text-lg-end mt-3 mt-lg-0">
                                                <div class="price-on-demand">
                                                    <span class="price-label">Prix sur demande</span>
                                                    <button class="contact-price-btn neo-btn neo-btn-primary mt-2">
                                                        <i class="fas fa-phone me-2"></i>Demander le prix
                                                    </button>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Enhanced Quick Specs Grid -->
                        <div class="row g-3 mt-2">
                            {% if voiture.annee %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Année</span>
                                            <span class="spec-value">{{ voiture.annee }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if voiture.kilometrage %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper bg-warning">
                                            <i class="fas fa-tachometer-alt"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Kilométrage</span>
                                            <span class="spec-value">{{ voiture.kilometrage|number_format(0, ',', ' ') }} km</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if voiture.carburant %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper bg-success">
                                            <i class="fas fa-gas-pump"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Carburant</span>
                                            <span class="spec-value">{{ voiture.carburant }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if voiture.boiteVitesse %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper bg-info">
                                            <i class="fas fa-cog"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Transmission</span>
                                            <span class="spec-value">{{ voiture.boiteVitesse }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enhanced Sidebar -->
            <div class="col-lg-4">
                <div class="neo-animate-on-scroll" style="animation-delay: 0.2s;">
                    <!-- Enhanced Create Announcement Card -->
                    <div class="announcement-card neo-card mb-4 overflow-hidden position-relative">
                        <!-- Gradient Background -->
                        <div class="gradient-bg"></div>
                        
                        <div class="card-content p-4 position-relative">
                            <div class="text-center text-white mb-4">
                                <div class="announcement-icon mb-3">
                                    <i class="fas fa-bullhorn fa-2x"></i>
                                </div>
                                <h3 class="h4 mb-2 fw-bold">Créer une Annonce</h3>
                                <p class="small mb-0 opacity-90">
                                    Transformez votre véhicule en annonce professionnelle
                                </p>
                            </div>
                            
                            <div class="announcement-features mb-4">
                                <div class="feature-item d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="small text-white">Publication instantanée</span>
                                </div>
                                <div class="feature-item d-flex align-items-center mb-2">
                                    <i class="fas fa-eye text-info me-2"></i>
                                    <span class="small text-white">Visibilité maximale</span>
                                </div>
                                <div class="feature-item d-flex align-items-center">
                                    <i class="fas fa-shield-alt text-warning me-2"></i>
                                    <span class="small text-white">Publication sécurisée</span>
                                </div>
                            </div>
                            
                            <div class="d-grid">
                                <a href="{{ path('create_annonce', {voitureId: voiture.id}) }}" 
                                   class="announcement-btn">
                                    <i class="fas fa-plus me-2"></i>Créer l'Annonce
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Quick Actions Card -->
                    <div class="quick-actions-card neo-card mb-4">
                        <div class="card-header-enhanced p-4 border-bottom">
                            <h4 class="h5 mb-0 d-flex align-items-center">
                                <i class="fas fa-bolt text-warning me-2"></i>Actions Rapides
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <div class="action-buttons-grid">
                                <button onclick="printVehicleInfo()" class="action-btn-enhanced">
                                    <i class="fas fa-print"></i>
                                    <span>Imprimer</span>
                                </button>
                                <button onclick="shareVehicle()" class="action-btn-enhanced">
                                    <i class="fas fa-share-alt"></i>
                                    <span>Partager</span>
                                </button>
                                <button onclick="saveToFavorites()" class="action-btn-enhanced">
                                    <i class="fas fa-heart"></i>
                                    <span>Favoris</span>
                                </button>
                                <a href="{{ path('app_voiture') }}" class="action-btn-enhanced">
                                    <i class="fas fa-arrow-left"></i>
                                    <span>Retour</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Vehicle Summary Card -->
                    <div class="vehicle-summary-card neo-card">
                        <div class="summary-header p-4 border-bottom">
                            <h4 class="h5 mb-0 d-flex align-items-center">
                                <i class="fas fa-info-circle text-primary me-2"></i>Résumé du Véhicule
                            </h4>
                        </div>
                        <div class="summary-content p-4">
                            <div class="summary-items">
                                <div class="summary-row">
                                    <div class="summary-label">
                                        <i class="fas fa-car text-primary"></i>
                                        <span>Marque</span>
                                    </div>
                                    <div class="summary-value">{{ voiture.marque }}</div>
                                </div>
                                <div class="summary-row">
                                    <div class="summary-label">
                                        <i class="fas fa-tag text-info"></i>
                                        <span>Modèle</span>
                                    </div>
                                    <div class="summary-value">{{ voiture.modele }}</div>
                                </div>
                                <div class="summary-row">
                                    <div class="summary-label">
                                        <i class="fas fa-calendar text-warning"></i>
                                        <span>Année</span>
                                    </div>
                                    <div class="summary-value">{{ voiture.annee ?: 'Non spécifié' }}</div>
                                </div>
                                {% if voiture.prix %}
                                    <div class="summary-row highlight">
                                        <div class="summary-label">
                                            <i class="fas fa-tag text-success"></i>
                                            <span>Prix</span>
                                        </div>
                                        <div class="summary-value price">{{ voiture.prix|number_format(0, ',', ' ') }} TND</div>
                                    </div>
                                {% endif %}
                                <div class="summary-row">
                                    <div class="summary-label">
                                        <i class="fas fa-tachometer-alt text-danger"></i>
                                        <span>Kilométrage</span>
                                    </div>
                                    <div class="summary-value">{{ voiture.kilometrage ? voiture.kilometrage|number_format(0, ',', ' ') ~ ' km' : 'Non spécifié' }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Neo Detailed Specifications Section -->
<section class="neo-section" style="background: var(--neo-gray-50);">
    <div class="neo-container">
        <div class="row g-5">
            <!-- Technical Specifications -->
            <div class="col-lg-8">
                <div class="neo-animate-on-scroll">
                    <div class="neo-card p-4 mb-4">
                        <h3 class="neo-heading-2 mb-4">
                            <i class="fas fa-cog text-primary me-2"></i>Spécifications Techniques
                        </h3>
                        <div class="row g-4">
                            {% if voiture.puissanceFiscale %}
                                <div class="col-md-6">
                                    <div class="spec-item d-flex align-items-center gap-3">
                                        <div class="spec-icon bg-warning">
                                            <i class="fas fa-bolt text-white"></i>
                                        </div>
                                        <div>
                                            <div class="spec-label">Puissance Fiscale</div>
                                            <div class="spec-value">{{ voiture.puissanceFiscale }} CV</div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if voiture.cylindree %}
                                <div class="col-md-6">
                                    <div class="spec-item d-flex align-items-center gap-3">
                                        <div class="spec-icon bg-danger">
                                            <i class="fas fa-industry text-white"></i>
                                        </div>
                                        <div>
                                            <div class="spec-label">Cylindrée</div>
                                            <div class="spec-value">{{ voiture.cylindree }}</div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if voiture.nombrePortes %}
                                <div class="col-md-6">
                                    <div class="spec-item d-flex align-items-center gap-3">
                                        <div class="spec-icon bg-secondary">
                                            <i class="fas fa-door-open text-white"></i>
                                        </div>
                                        <div>
                                            <div class="spec-label">Nombre de Portes</div>
                                            <div class="spec-value">{{ voiture.nombrePortes }} portes</div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="col-md-6">
                                <div class="spec-item d-flex align-items-center gap-3">
                                    <div class="spec-icon bg-primary">
                                        <i class="fas fa-info-circle text-white"></i>
                                    </div>
                                    <div>
                                        <div class="spec-label">État Général</div>
                                        <div class="spec-value">Excellent</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Vehicle History Section -->
                    <div class="neo-card p-4">
                        <h3 class="neo-heading-2 mb-4">
                            <i class="fas fa-history text-primary me-2"></i>Historique du Véhicule
                        </h3>
                        <div class="neo-body text-muted" style="line-height: 1.8;">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                Ce véhicule {{ voiture.marque }} {{ voiture.modele }} 
                                {% if voiture.annee %}de {{ voiture.annee }}{% endif %} 
                                est en excellente condition. 
                                {% if voiture.kilometrage %}Avec {{ voiture.kilometrage|number_format(0, ',', ' ') }} km au compteur{% endif %}, 
                                il représente une excellente opportunité d'achat.
                            </div>
                            <p>
                                <strong>Points forts du véhicule :</strong>
                            </p>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-check text-success me-2"></i>Entretien régulier effectué</li>
                                <li><i class="fas fa-check text-success me-2"></i>Aucun accident déclaré</li>
                                <li><i class="fas fa-check text-success me-2"></i>Carnet d'entretien disponible</li>
                                <li><i class="fas fa-check text-success me-2"></i>Contrôle technique à jour</li>
                                <li><i class="fas fa-check text-success me-2"></i>Garantie constructeur disponible</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Information -->
            <div class="col-lg-4">
                <div class="neo-animate-on-scroll" style="animation-delay: 0.3s;">
                    <!-- Features & Equipment -->
                    <div class="neo-card p-4 mb-4">
                        <h4 class="neo-heading-3 mb-3">
                            <i class="fas fa-star text-warning me-2"></i>Équipements & Options
                        </h4>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Climatisation automatique</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Système de navigation GPS</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Bluetooth & connectivité</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Airbags multiples</span>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="neo-card p-4">
                        <h4 class="neo-heading-3 mb-3">
                            <i class="fas fa-phone text-primary me-2"></i>Informations de Contact
                        </h4>
                        <div class="d-flex flex-column gap-3">
                            <div class="neo-glass p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-building text-primary"></i>
                                    <strong>NeoCarVilla</strong>
                                </div>
                                <div class="neo-body-small text-muted">Concessionnaire agréé</div>
                            </div>
                            <div class="neo-glass p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-phone text-success"></i>
                                    <strong>+216 12 345 678</strong>
                                </div>
                                <div class="neo-body-small text-muted">Téléphone direct</div>
                            </div>
                            <div class="neo-glass p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-envelope text-info"></i>
                                    <strong>contact@neocarvilla.tn</strong>
                                </div>
                                <div class="neo-body-small text-muted">Email professionnel</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Neo Similar Vehicles Section -->
<section class="neo-section">
    <div class="neo-container">
        <div class="text-center mb-5 neo-animate-on-scroll">
            <h2 class="neo-heading-1 mb-3">Véhicules Similaires</h2>
            <p class="neo-body-large text-muted">Découvrez d'autres véhicules de la même catégorie</p>
        </div>
        
        <div class="row g-4">
            <!-- Similar Vehicle 1 -->
            <div class="col-lg-4 col-md-6 neo-animate-on-scroll">
                <div class="neo-card overflow-hidden">
                    <div class="position-relative">
                        <div class="w-100 d-flex align-items-center justify-content-center text-muted" 
                             style="height: 220px; background: var(--neo-gray-100);">
                            <i class="fas fa-car fa-3x"></i>
                        </div>
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge" style="background: var(--neo-gradient-success); padding: 0.5rem 1rem;">Disponible</span>
                        </div>
                    </div>
                    <div class="p-4">
                        <h4 class="neo-heading-3 mb-2">{{ voiture.marque }} Modèle Similaire</h4>
                        <p class="neo-body-small text-muted mb-3">2023 • 20,000 km • Automatique</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="neo-heading-3 text-primary">Prix sur demande</span>
                        </div>
                        <a href="{{ path('app_voiture') }}" class="neo-btn neo-btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Voir Détails
                        </a>
                    </div>
                </div>
            </div>

            <!-- Similar Vehicle 2 -->
            <div class="col-lg-4 col-md-6 neo-animate-on-scroll" style="animation-delay: 0.2s;">
                <div class="neo-card overflow-hidden">
                    <div class="position-relative">
                        <div class="w-100 d-flex align-items-center justify-content-center text-muted" 
                             style="height: 220px; background: var(--neo-gray-100);">
                            <i class="fas fa-car fa-3x"></i>
                        </div>
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge" style="background: var(--neo-gradient-success); padding: 0.5rem 1rem;">Disponible</span>
                        </div>
                    </div>
                    <div class="p-4">
                        <h4 class="neo-heading-3 mb-2">Alternative {{ voiture.marque }}</h4>
                        <p class="neo-body-small text-muted mb-3">2022 • 30,000 km • Manuelle</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="neo-heading-3 text-primary">Prix sur demande</span>
                        </div>
                        <a href="{{ path('app_voiture') }}" class="neo-btn neo-btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Voir Détails
                        </a>
                    </div>
                </div>
            </div>

            <!-- Similar Vehicle 3 -->
            <div class="col-lg-4 col-md-6 neo-animate-on-scroll" style="animation-delay: 0.4s;">
                <div class="neo-card overflow-hidden">
                    <div class="position-relative">
                        <div class="w-100 d-flex align-items-center justify-content-center text-muted" 
                             style="height: 220px; background: var(--neo-gray-100);">
                            <i class="fas fa-car fa-3x"></i>
                        </div>
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge" style="background: var(--neo-gradient-success); padding: 0.5rem 1rem;">Disponible</span>
                        </div>
                    </div>
                    <div class="p-4">
