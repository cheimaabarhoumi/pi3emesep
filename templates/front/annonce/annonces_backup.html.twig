{% extends 'front/base.html.twig' %}

{% block title %}Nos Annonces - Neo Cars{% endblock %}

{% block content %}
<div class="container-fluid py-5">
    <!-- Page Header -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 fw-bold text-primary mb-3">
                <i class="fas fa-bullhorn me-3"></i>Nos Annonces
            </h1>
            <p class="lead text-muted">Découvrez notre collection d'annonces de véhicules d'exception</p>
            <div class="badge bg-primary fs-6 px-3 py-2">
                <span id="annoncesTotalCount">{{ pagination.getTotalItemCount() }}</span> annonce<span id="annoncesPlural">{{ pagination.getTotalItemCount() > 1 ? 's' : '' }}</span> disponible<span id="annoncesPlural2">{{ pagination.getTotalItemCount() > 1 ? 's' : '' }}</span>
            </div>
        </div>
    </div>

    <div class="row">
            <!-- Search Sidebar -->
            <div class="col-lg-3 col-md-4">
                <div class="card shadow-lg border-0 rounded-4 sticky-top" style="top: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="card-header border-0 text-white text-center py-4" style="background: transparent;">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-search me-2"></i>Recherche Intelligente
                        </h5>
                        <small class="opacity-75">Trouvez l'annonce parfaite</small>
                    </div>
                    <div class="card-body p-4" style="background: rgba(255,255,255,0.95); margin: 1rem; border-radius: 1rem;">
                        <!-- Live Search by Name -->
                        <div class="mb-4">
                            <label for="liveSearchAnnonce" class="form-label fw-semibold d-flex align-items-center">
                                <i class="fas fa-magic text-primary me-2"></i>Recherche Instantanée
                            </label>
                            <div class="search-container position-relative">
                                <input type="text" 
                                       class="form-control form-control-lg ps-5" 
                                       id="liveSearchAnnonce"
                                       placeholder="Titre, marque, modèle..."
                                       autocomplete="off"
                                       style="border: 2px solid #e9ecef; border-radius: 50px; background: #f8f9fa;">
                                <i class="fas fa-search position-absolute" 
                                   style="left: 1rem; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
                                <button type="button" 
                                        class="btn-clear position-absolute" 
                                        id="clearSearchAnnonce"
                                        style="right: 1rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: #dc3545; display: none;">
                                    <i class="fas fa-times-circle"></i>
                                </button>
                            </div>
                            <div class="search-suggestions mt-2" id="searchSuggestionsAnnonce" style="display: none;">
                                <small class="text-muted">Suggestions populaires:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="badge bg-light text-dark suggestion-pill" data-suggestion="Mercedes">Mercedes</span>
                                    <span class="badge bg-light text-dark suggestion-pill" data-suggestion="BMW">BMW</span>
                                    <span class="badge bg-light text-dark suggestion-pill" data-suggestion="Audi">Audi</span>
                                    <span class="badge bg-light text-dark suggestion-pill" data-suggestion="Toyota">Toyota</span>
                                </div>
                            </div>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>Résultats instantanés dès la première lettre
                            </small>
                        </div>
                        
                        <!-- Price Range with Visual Display -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-flex align-items-center">
                                <i class="fas fa-dollar-sign text-success me-2"></i>Gamme de Prix
                            </label>
                            
                            <!-- Price Display -->
                            <div class="price-display mb-3 p-3 rounded-3" style="background: linear-gradient(45deg, #28a745, #20c997);">
                                <div class="d-flex justify-content-between align-items-center text-white">
                                    <div>
                                        <small class="opacity-75">De</small>
                                        <div class="fw-bold" id="minPriceDisplayAnnonce">0 TND</div>
                                    </div>
                                    <div class="text-center">
                                        <i class="fas fa-arrows-alt-h"></i>
                                    </div>
                                    <div class="text-end">
                                        <small class="opacity-75">À</small>
                                        <div class="fw-bold" id="maxPriceDisplayAnnonce">∞</div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" 
                                           class="form-control" 
                                           id="annoncesPriceMin" 
                                           placeholder="Prix min"
                                           min="0"
                                           step="1000"
                                           style="border-radius: 20px;">
                                    <small class="text-muted">Prix minimum</small>
                                </div>
                                <div class="col-6">
                                    <input type="number" 
                                           class="form-control" 
                                           id="annoncesPriceMax" 
                                           placeholder="Prix max"
                                           min="0"
                                           step="1000"
                                           style="border-radius: 20px;">
                                    <small class="text-muted">Prix maximum</small>
                                </div>
                            </div>
                            
                            <!-- Quick Price Filters -->
                            <div class="mt-3">
                                <small class="text-muted mb-2 d-block">Sélection rapide:</small>
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm price-filter-annonce rounded-pill" 
                                            data-min="0" data-max="15000">
                                        <i class="fas fa-tag me-1"></i>Moins de 15k TND
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm price-filter-annonce rounded-pill" 
                                            data-min="15000" data-max="40000">
                                        <i class="fas fa-tags me-1"></i>15k - 40k TND
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm price-filter-annonce rounded-pill" 
                                            data-min="40000" data-max="80000">
                                        <i class="fas fa-crown me-1"></i>40k - 80k TND
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm price-filter-annonce rounded-pill" 
                                            data-min="80000" data-max="">
                                        <i class="fas fa-gem me-1"></i>Plus de 80k TND
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-secondary rounded-pill" id="resetAnnoncesFilters">
                                <i class="fas fa-refresh me-2"></i>Tout Réinitialiser
                            </button>
                        </div>
                        
                        <!-- Results Info -->
                        <div class="mt-4 p-3 rounded-3" style="background: linear-gradient(45deg, #e3f2fd, #f3e5f5); border: 1px solid #e1bee7;">
                            <div class="text-center">
                                <i class="fas fa-chart-bar text-primary mb-2"></i>
                                <div class="fw-bold text-primary" id="annonceFilterResults">Affichage de toutes les annonces</div>
                                <small class="text-muted">Résultats en temps réel</small>
                            </div>
                        </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 col-md-8">
                <!-- Loading Indicator -->
                <div id="loadingIndicator" class="text-center mb-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Recherche en cours...</span>
                    </div>
                    <p class="mt-2 text-muted">Recherche en cours...</p>
                </div>
                
                <!-- Results Header -->
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-2">Résultats de Recherche</h2>
                        <p class="text-muted">
                            <span id="filterResults">Affichage de toutes les annonces</span>
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <label class="fw-semibold small">Trier par:</label>
                        <select class="form-select" style="width: auto; border-radius: 20px;">
                            <option>Plus récent</option>
                            <option>Prix croissant</option>
                            <option>Prix décroissant</option>
                            <option>Kilométrage</option>
                            <option>Année</option>
                        </select>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-primary active" data-view="grid">
                                <i class="fas fa-th-large"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary" data-view="list">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cars Grid -->
                <div class="row g-4" id="annoncesGrid">
                    {% for annonce in pagination %}
                        {% set voiture = annonce.voiture %}
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 annonce-item" 
                             data-search="{{ (annonce.titre ~ ' ' ~ voiture.marque ~ ' ' ~ voiture.modele)|lower }}"
                             data-prix="{{ voiture.prix ?: 0 }}">
                            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden" style="transition: all 0.3s ease;">
                                <!-- Image Section -->
                                <div class="position-relative overflow-hidden">
                                    {% if voiture.image %}
                                        <img src="{{ asset('uploads/' ~ voiture.image) }}" 
                                             alt="{{ voiture.marque }} {{ voiture.modele }}" 
                                             class="card-img-top" 
                                             style="height: 220px; object-fit: cover; transition: transform 0.3s ease;">
                                    {% else %}
                                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 220px;">
                                            <div class="text-center text-muted">
                                                <i class="fas fa-car fa-3x mb-2"></i>
                                                <div class="small">Aucune image</div>
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    <!-- Badges -->
                                    <div class="position-absolute top-0 start-0 m-3">
                                        {% if annonce.valider %}
                                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                                <i class="fas fa-check me-1"></i>Validée
                                            </span>
                                        {% else %}
                                            <span class="badge bg-warning px-3 py-2 rounded-pill">
                                                <i class="fas fa-clock me-1"></i>En attente
                                            </span>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-dark px-3 py-2 rounded-pill">
                                            {{ voiture.annee }}
                                        </span>
                                    </div>
                                    
                                    <!-- Price Badge -->
                                    {% if voiture.prix %}
                                        <div class="position-absolute bottom-0 end-0 m-3">
                                            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                                                {{ voiture.prix|number_format(0, ',', ' ') }} TND
                                            </span>
                                        </div>
                                    {% endif %}
                                    
                                    <!-- Hover Overlay -->
                                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center opacity-0 hover-overlay" 
                                         style="background: rgba(0,0,0,0.7); transition: opacity 0.3s ease;">
                                        <a href="{{ path('front_annonce_details', { id: annonce.id }) }}" 
                                           class="btn btn-light btn-lg rounded-pill">
                                            <i class="fas fa-eye me-2"></i>Voir Détails
                                        </a>
                                    </div>
                                </div>

                                <!-- Content Section -->
                                <div class="card-body d-flex flex-column">
                                    <!-- Title & Basic Info -->
                                    <div class="mb-3">
                                        <h5 class="card-title fw-bold text-primary mb-2" style="line-height: 1.3;">
                                            {{ voiture.marque }} {{ voiture.modele }}
                                        </h5>
                                        <p class="text-muted small mb-0">{{ annonce.titre }}</p>
                                    </div>

                                    <!-- Specifications -->
                                    <div class="row g-2 mb-3 text-center small">
                                        <div class="col-4">
                                            <div class="bg-light p-2 rounded-3">
                                                <i class="fas fa-tachometer-alt text-primary mb-1 d-block"></i>
                                                <div class="fw-semibold">{{ voiture.kilometrage ?: 'N/A' }}</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">km</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="bg-light p-2 rounded-3">
                                                <i class="fas fa-cogs text-success mb-1 d-block"></i>
                                                <div class="fw-semibold">{{ voiture.boiteVitesse ?: 'N/A' }}</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">trans</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="bg-light p-2 rounded-3">
                                                <i class="fas fa-gas-pump text-warning mb-1 d-block"></i>
                                                <div class="fw-semibold">{{ voiture.carburant|slice(0, 3)|upper ?: 'N/A' }}</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">type</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="mt-auto">
                                        <div class="d-grid gap-2">
                                            <a href="{{ path('front_annonce_details', { id: annonce.id }) }}" 
                                               class="btn btn-primary">
                                                <i class="fas fa-eye me-2"></i>Voir Détails
                                            </a>
                                            {% if voiture.prix %}
                                                <small class="text-center text-muted">
                                                    <i class="fas fa-tag me-1"></i>
                                                    Prix: <strong>{{ voiture.prix|number_format(0, ',', ' ') }} TND</strong>
                                                </small>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                {% if pagination.getTotalItemCount() > 0 %}
                    <div class="d-flex justify-content-center mt-5">
                        {{ knp_pagination_render(pagination) }}
                    </div>
                {% endif %}
                
                <!-- No Results Message -->
                <div id="noResults" class="text-center mt-5" style="display: none;">
                    <div class="card border-0 shadow-sm p-5">
                        <i class="fas fa-search fa-4x text-muted mb-4"></i>
                        <h3 class="fw-bold text-muted mb-3">Aucune annonce trouvée</h3>
                        <p class="text-muted mb-4">Essayez de modifier vos critères de recherche ou explorez toutes nos annonces.</p>
                        <button class="btn btn-primary rounded-pill" onclick="resetAllFilters()">
                            <i class="fas fa-refresh me-2"></i>Voir toutes les annonces
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add hover effects with CSS -->
<style>
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
}

.card:hover .hover-overlay {
    opacity: 1 !important;
}

.card:hover img {
    transform: scale(1.05);
}
</style>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Enhanced dynamic search functionality for annonces
        document.addEventListener('DOMContentLoaded', function() {
            const liveSearchAnnonce = document.getElementById('liveSearchAnnonce');
            const clearButtonAnnonce = document.getElementById('clearSearchAnnonce');
            const annoncesPriceMin = document.getElementById('annoncesPriceMin');
            const annoncesPriceMax = document.getElementById('annoncesPriceMax');
            const annonceItems = document.querySelectorAll('.annonce-item');
            const annoncesGrid = document.getElementById('annoncesGrid');
            const annoncesTotalCount = document.getElementById('annoncesTotalCount');
            const annoncesPlural = document.getElementById('annoncesPlural');
            const annoncesPlural2 = document.getElementById('annoncesPlural2');
            const annonceFilterResults = document.getElementById('annonceFilterResults');
            const resetAnnoncesBtn = document.getElementById('resetAnnoncesFilters');
            const annoncePriceFilterBtns = document.querySelectorAll('.price-filter-annonce');
            const minPriceDisplayAnnonce = document.getElementById('minPriceDisplayAnnonce');
            const maxPriceDisplayAnnonce = document.getElementById('maxPriceDisplayAnnonce');
            const searchSuggestionsAnnonce = document.getElementById('searchSuggestionsAnnonce');
            const suggestionPillsAnnonce = document.querySelectorAll('.suggestion-pill');
            
            let searchTimeout;
            
            // Update price display
            function updatePriceDisplayAnnonce() {
                const minPrice = annoncesPriceMin.value ? parseInt(annoncesPriceMin.value).toLocaleString() + ' TND' : '0 TND';
                const maxPrice = annoncesPriceMax.value ? parseInt(annoncesPriceMax.value).toLocaleString() + ' TND' : '∞';
                if (minPriceDisplayAnnonce) minPriceDisplayAnnonce.textContent = minPrice;
                if (maxPriceDisplayAnnonce) maxPriceDisplayAnnonce.textContent = maxPrice;
            }
            
            // Show/hide clear button and suggestions
            function toggleClearButtonAnnonce() {
                if (clearButtonAnnonce) {
                    if (liveSearchAnnonce.value.length > 0) {
                        clearButtonAnnonce.style.display = 'block';
                        if (searchSuggestionsAnnonce) searchSuggestionsAnnonce.style.display = 'none';
                    } else {
                        clearButtonAnnonce.style.display = 'none';
                        if (searchSuggestionsAnnonce && !liveSearchAnnonce.matches(':focus')) {
                            searchSuggestionsAnnonce.style.display = 'none';
                        }
                    }
                }
            }
            
            // Live search functionality for annonces
            function performAnnonceSearch() {
                const searchTerm = liveSearchAnnonce.value.toLowerCase().trim();
                const minPrice = parseFloat(annoncesPriceMin.value) || 0;
                const maxPrice = parseFloat(annoncesPriceMax.value) || Infinity;
                
                let visibleCount = 0;
                
                annonceItems.forEach(item => {
                    const searchData = item.dataset.search;
                    const itemPrice = parseFloat(item.dataset.prix) || 0;
                    
                    const matchesSearch = searchTerm === '' || searchData.includes(searchTerm);
                    const matchesPrice = itemPrice >= minPrice && itemPrice <= maxPrice;
                    
                    if (matchesSearch && matchesPrice) {
                        item.style.display = 'block';
                        item.style.opacity = '1';
                        item.style.transform = 'translateY(0)';
                        item.classList.add('fade-in');
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                        item.classList.remove('fade-in');
                    }
                });
                
                // Update results info
                updateAnnonceResultsInfo(visibleCount, searchTerm, minPrice, maxPrice);
                toggleClearButtonAnnonce();
                
                // Show/hide no results message
                const noResults = document.getElementById('noResults');
                if (noResults && annoncesGrid) {
                    if (visibleCount === 0) {
                        annoncesGrid.style.display = 'none';
                        noResults.style.display = 'block';
                    } else {
                        annoncesGrid.style.display = 'block';
                        noResults.style.display = 'none';
                    }
                }
            }
            
            function updateAnnonceResultsInfo(count, searchTerm, minPrice, maxPrice) {
                if (annoncesTotalCount) annoncesTotalCount.textContent = count;
                if (annoncesPlural) annoncesPlural.textContent = count > 1 ? 's' : '';
                if (annoncesPlural2) annoncesPlural2.textContent = count > 1 ? 's' : '';
                
                const filterResults = document.getElementById('filterResults');
                if (filterResults) {
                    // Update with animation
                    filterResults.style.opacity = '0.5';
                    setTimeout(() => {
                        let filterText = '';
                        if (count === 0) {
                            filterResults.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Aucune annonce trouvée';
                            filterResults.className = 'fw-bold text-warning';
                        } else if (searchTerm || minPrice > 0 || maxPrice < Infinity) {
                            filterText = `<i class="fas fa-filter me-1"></i>${count} annonce${count > 1 ? 's' : ''} trouvée${count > 1 ? 's' : ''}`;
                            if (searchTerm) filterText += ` pour "${searchTerm}"`;
                            filterResults.innerHTML = filterText;
                            filterResults.className = 'fw-bold text-primary';
                        } else {
                            filterResults.innerHTML = `<i class="fas fa-check-circle me-1"></i>Affichage de toutes les annonces (${count})`;
                            filterResults.className = 'fw-bold text-success';
                        }
                        filterResults.style.opacity = '1';
                    }, 150);
                }
            }
            
            // Clear search function
            function clearSearchAnnonce() {
                liveSearchAnnonce.value = '';
                liveSearchAnnonce.focus();
                performAnnonceSearch();
                
                // Visual feedback
                liveSearchAnnonce.style.borderColor = '#28a745';
                setTimeout(() => {
                    liveSearchAnnonce.style.borderColor = '#e9ecef';
                }, 300);
            }
            
            // Reset all filters function
            function resetAllAnnoncesFilters() {
                liveSearchAnnonce.value = '';
                annoncesPriceMin.value = '';
                annoncesPriceMax.value = '';
                
                annoncePriceFilterBtns.forEach(btn => btn.classList.remove('active'));
                updatePriceDisplayAnnonce();
                performAnnonceSearch();
                
                // Visual feedback
                const inputs = [liveSearchAnnonce, annoncesPriceMin, annoncesPriceMax];
                inputs.forEach(input => {
                    input.style.borderColor = '#28a745';
                    setTimeout(() => {
                        input.style.borderColor = '#e9ecef';
                    }, 300);
                });
            }
            
            // Event listeners for live search
            if (liveSearchAnnonce) {
                liveSearchAnnonce.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        this.style.borderColor = '#667eea';
                        performAnnonceSearch();
                        
                        setTimeout(() => {
                            this.style.borderColor = '#e9ecef';
                        }, 300);
                    }, 150);
                });
                
                // Focus events for suggestions
                liveSearchAnnonce.addEventListener('focus', function() {
                    if (this.value.length === 0 && searchSuggestionsAnnonce) {
                        searchSuggestionsAnnonce.style.display = 'block';
                    }
                });
                
                liveSearchAnnonce.addEventListener('blur', function() {
                    setTimeout(() => {
                        if (searchSuggestionsAnnonce) searchSuggestionsAnnonce.style.display = 'none';
                    }, 200);
                });
            }
            
            // Clear button functionality
            if (clearButtonAnnonce) {
                clearButtonAnnonce.addEventListener('click', clearSearchAnnonce);
            }
            
            // Suggestion pills
            suggestionPillsAnnonce.forEach(pill => {
                pill.addEventListener('click', function() {
                    liveSearchAnnonce.value = this.getAttribute('data-suggestion');
                    performAnnonceSearch();
                    liveSearchAnnonce.focus();
                });
            });
            
            // Price filter event listeners
            if (annoncesPriceMin) {
                annoncesPriceMin.addEventListener('input', function() {
                    updatePriceDisplayAnnonce();
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(performAnnonceSearch, 300);
                });
                annoncesPriceMin.addEventListener('change', performAnnonceSearch);
            }
            
            if (annoncesPriceMax) {
                annoncesPriceMax.addEventListener('input', function() {
                    updatePriceDisplayAnnonce();
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(performAnnonceSearch, 300);
                });
                annoncesPriceMax.addEventListener('change', performAnnonceSearch);
            }
            
            // Quick price filter buttons
            annoncePriceFilterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const minVal = this.dataset.min;
                    const maxVal = this.dataset.max;
                    
                    annoncesPriceMin.value = minVal;
                    annoncesPriceMax.value = maxVal;
                    updatePriceDisplayAnnonce();
                    
                    annoncePriceFilterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Button animation
                    this.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        this.style.transform = 'scale(1)';
                    }, 150);
                    
                    performAnnonceSearch();
                });
            });
            
            // Reset filters
            if (resetAnnoncesBtn) {
                resetAnnoncesBtn.addEventListener('click', resetAllAnnoncesFilters);
            }
            
            // Keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Escape to clear search or reset all
                if (e.key === 'Escape' && liveSearchAnnonce.matches(':focus')) {
                    if (liveSearchAnnonce.value) {
                        clearSearchAnnonce();
                    } else {
                        resetAllAnnoncesFilters();
                    }
                }
                
                // Ctrl/Cmd + F to focus search
                if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                    e.preventDefault();
                    liveSearchAnnonce.focus();
                    liveSearchAnnonce.select();
                }
            });
            
            // Original functionality for view toggle
            const viewButtons = document.querySelectorAll('[data-view]');
            const carsGrid = document.getElementById('annoncesGrid');
            
            viewButtons.forEach(button => {
                button.addEventListener('click', function() {
                    viewButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    const view = this.dataset.view;
                    if (view === 'list') {
                        carsGrid.className = 'row g-3';
                        carsGrid.querySelectorAll('.annonce-item').forEach(card => {
                            card.className = 'col-12 annonce-item';
                            card.style.display = card.style.display; // Preserve visibility
                        });
                    } else {
                        carsGrid.className = 'row g-4';
                        carsGrid.querySelectorAll('.annonce-item').forEach(card => {
                            card.className = 'col-xl-3 col-lg-4 col-md-6 col-sm-6 annonce-item';
                            card.style.display = card.style.display; // Preserve visibility
                        });
                    }
                });
            });
            
            // Add enhanced styles for better UX
            const style = document.createElement('style');
            style.textContent = `
                .annonce-item {
                    transition: all 0.3s ease;
                }
                
                .fade-in {
                    animation: fadeIn 0.3s ease-in-out;
                }
                
                @keyframes fadeIn {
                    from { opacity: 0; transform: translateY(10px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                
                .search-container input:focus {
                    border-color: #667eea !important;
                    box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25) !important;
                    transform: translateY(-1px);
                    transition: all 0.2s ease;
                }
                
                .suggestion-pill {
                    cursor: pointer;
                    transition: all 0.2s ease;
                }
                
                .suggestion-pill:hover {
                    background-color: #667eea !important;
                    color: white !important;
                    transform: translateY(-1px);
                }
                
                .price-filter-annonce {
                    transition: all 0.2s ease;
                }
                
                .price-filter-annonce:hover {
                    transform: translateY(-1px);
                }
                
                .price-filter-annonce.active {
                    background-color: #667eea !important;
                    color: white !important;
                    border-color: #667eea !important;
                }
                
                .btn-clear {
                    transition: all 0.2s ease;
                }
                
                .btn-clear:hover {
                    color: #dc3545 !important;
                    transform: translateY(-50%) scale(1.1);
                }
                
                #liveSearchAnnonce:focus {
                    border-color: #667eea;
                    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
                }
            `;
            document.head.appendChild(style);
            
            // Initialize
            updatePriceDisplayAnnonce();
            toggleClearButtonAnnonce();
            
            // Initialize with any existing search term
            if (liveSearchAnnonce.value) {
                performAnnonceSearch();
            }
        });
    </script>
{% endblock %}
