{% extends 'front/base.html.twig' %}

{% block title %}Créer une Annonce - Neo Cars{% endblock %}

{% block content %}
<!-- Neo Page Header -->
<div class="neo-page-header">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <nav aria-label="breadcrumb" class="neo-breadcrumb mb-4">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_home') }}">
                                <i class="fas fa-home"></i> Accueil
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="{{ path('front_annonces') }}">Annonces</a>
                        </li>
                        <li class="breadcrumb-item active">Créer</li>
                    </ol>
                </nav>
                
                <div class="neo-header-content">
                    <h1 class="neo-heading-1 mb-3">
                        <i class="fas fa-megaphone neo-text-primary me-3"></i>
                        Créer une Annonce
                    </h1>
                    <p class="neo-body-large text-muted">
                        Créez une annonce pour votre véhicule <strong>{{ voiture.marque ~ ' ' ~ voiture.modele }}</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Vehicle Summary Card -->
<section class="neo-section py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="neo-card p-4 mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-2 text-center">
                            <i class="fas fa-car fa-3x neo-text-primary"></i>
                        </div>
                        <div class="col-md-10">
                            <h4 class="neo-heading-4 mb-2">Véhicule Sélectionné</h4>
                            <p class="neo-body mb-1">
                                <strong>{{ voiture.marque ~ ' ' ~ voiture.modele }}</strong> - {{ voiture.annee }}
                            </p>
                            <div class="d-flex gap-3 text-muted small">
                                <span><i class="fas fa-tachometer-alt me-1"></i>{{ voiture.kilometrage }} km</span>
                                <span><i class="fas fa-gas-pump me-1"></i>{{ voiture.carburant }}</span>
                                <span><i class="fas fa-euro-sign me-1"></i>{{ voiture.prix|number_format(0, ',', ' ') }} €</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Neo Form Section -->
<section class="neo-section pb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="neo-card p-5">
                    {{ form_start(form, {'attr': {'class': 'neo-form', 'id': 'front-annonce-form'}}) }}
                    
                    <div class="row g-4">
                        <!-- Announcement Details -->
                        <div class="col-12">
                            <h3 class="neo-heading-3 mb-4">
                                <i class="fas fa-edit neo-text-primary me-2"></i>
                                Détails de l'Annonce
                            </h3>
                        </div>
                        
                        <div class="col-12">
                            <div class="neo-form-group">
                                {{ form_label(form.titre, null, {'label_attr': {'class': 'neo-form-label'}}) }}
                                {{ form_widget(form.titre, {'attr': {'class': 'neo-form-control', 'placeholder': 'Ex: Magnifique BMW Serie 3 en excellent état', 'required': 'required'}}) }}
                                <small class="neo-form-help">
                                    <i class="fas fa-lightbulb me-1"></i>
                                    Un titre accrocheur augmente les chances de vente
                                </small>
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <div class="neo-form-group">
                                {{ form_label(form.voiture, null, {'label_attr': {'class': 'neo-form-label'}}) }}
                                {{ form_widget(form.voiture, {'attr': {'class': 'neo-form-control', 'readonly': true, 'required': 'required'}}) }}
                                <small class="neo-form-help">
                                    <i class="fas fa-lock me-1"></i>
                                    Véhicule sélectionné automatiquement
                                </small>
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <div class="neo-form-group">
                                {{ form_label(form.description, null, {'label_attr': {'class': 'neo-form-label'}}) }}
                                {{ form_widget(form.description, {'attr': {'class': 'neo-form-control neo-textarea', 'rows': 6, 'placeholder': 'Décrivez votre véhicule en détail : état, équipements, historique d\'entretien, points forts...', 'required': 'required'}}) }}
                                <small class="neo-form-help">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Une description détaillée inspire confiance aux acheteurs
                                </small>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="col-12 text-center mt-5">
                            <div class="d-flex gap-3 justify-content-center flex-wrap">
                                <button type="submit" form="front-annonce-form" class="neo-btn neo-btn-primary neo-btn-lg" id="submit-btn">
                                    <i class="fas fa-rocket me-2"></i>
                                    Publier l'Annonce
                                </button>
                                <a href="{{ path('front_voiture_details', {id: voiture.id}) }}" class="neo-btn neo-btn-secondary neo-btn-lg">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    Retour au Véhicule
                                </a>
                            </div>
                        </div>
                        
                        <!-- Tips Section -->
                        <div class="col-12 mt-5">
                            <div class="neo-alert neo-alert-info">
                                <h5 class="neo-heading-5 mb-3">
                                    <i class="fas fa-tips neo-text-primary me-2"></i>
                                    Conseils pour une annonce réussie
                                </h5>
                                <ul class="neo-body mb-0">
                                    <li>Soyez honnête sur l'état du véhicule</li>
                                    <li>Mentionnez tous les équipements et options</li>
                                    <li>Indiquez l'historique d'entretien</li>
                                    <li>Précisez les raisons de la vente</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
<script src="{{ asset('js/form-validator.js') }}"></script>
<script>
  initFormValidation('#front-annonce-form', {
    titre: { required: true, minLength: 5, messages: { required: 'Titre requis', minLength: 'Au moins 5 caractères' } },
    description: { required: true, minLength: 10, messages: { required: 'Description requise', minLength: 'Au moins 10 caractères' } }
  });
</script>
            </div>
        </div>
    </div>
</section>

<!-- Confirmation Script -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const submitBtn = document.getElementById("submit-btn");
    const form = submitBtn.closest("form");

    submitBtn.addEventListener("click", function (e) {
        if (form.checkValidity()) {
            e.preventDefault();
            
            // Modern confirmation modal
            const confirmModal = document.createElement('div');
            confirmModal.className = 'neo-modal-overlay';
            confirmModal.innerHTML = `
                <div class="neo-modal">
                    <div class="neo-modal-header">
                        <h4 class="neo-heading-4 mb-0">
                            <i class="fas fa-check-circle neo-text-success me-2"></i>
                            Confirmer la Publication
                        </h4>
                    </div>
                    <div class="neo-modal-body">
                        <p class="neo-body">Êtes-vous sûr de vouloir publier cette annonce ?</p>
                        <p class="neo-body-small text-muted">Une fois publiée, elle sera visible par tous les utilisateurs.</p>
                    </div>
                    <div class="neo-modal-footer">
                        <button type="button" class="neo-btn neo-btn-secondary" onclick="this.closest('.neo-modal-overlay').remove()">
                            Annuler
                        </button>
                        <button type="button" class="neo-btn neo-btn-primary" onclick="document.querySelector('form').submit()">
                            <i class="fas fa-rocket me-2"></i>Publier
                        </button>
                    </div>
                </div>
            `;
            
            document.body.appendChild(confirmModal);
        } else {
            form.reportValidity();
        }
    });
});
</script>

{# Form validation is loaded globally through app.js #}
{% endblock %}