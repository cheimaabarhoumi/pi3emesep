{% extends 'front/base.html.twig' %}

{% block title %}{{ annonce.titre }} - NeoCarVilla{% endblock %}

{% block content %}
<!-- Enhanced Neo Breadcrumb Section -->
<section class="neo-section py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin-top: 80px; position: relative; overflow: hidden;">
    <!-- Animated Background Particles -->
    <div class="particles-bg">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>
    
    <div class="neo-container position-relative">
        <nav aria-label="breadcrumb" class="neo-animate-on-scroll">
            <div class="modern-breadcrumb p-4 rounded-4">
                <ol class="breadcrumb mb-0 d-flex align-items-center">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_front_accueil') }}" class="breadcrumb-link">
                            <i class="fas fa-home me-2"></i>Accueil
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('front_annonces') }}" class="breadcrumb-link">Annonces</a>
                    </li>
                    <li class="breadcrumb-item active">{{ annonce.titre }}</li>
                </ol>
            </div>
        </nav>
        
        <!-- Hero Title Section -->
        <div class="hero-title-section text-center text-white mt-4 neo-animate-on-scroll" style="animation-delay: 0.2s;">
            <h1 class="display-3 fw-bold mb-3" style="text-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                {{ annonce.titre }}
            </h1>
            <h2 class="h4 mb-3 opacity-90">{{ annonce.voiture.marque }} {{ annonce.voiture.modele }}</h2>
            {% if annonce.voiture.prix %}
                <div class="price-highlight d-inline-block px-4 py-2 rounded-pill" 
                     style="background: rgba(255,255,255,0.2); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.3);">
                    <span class="h3 mb-0 fw-bold">{{ annonce.voiture.prix|number_format(0, ',', ' ') }} TND</span>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<!-- Enhanced Neo Car Details Section -->
<section class="neo-section py-5" style="background: linear-gradient(to bottom, #f8fafc 0%, #e2e8f0 100%);">
    <div class="neo-container">
        <div class="row g-5">
            <!-- Main Image & Gallery -->
            <div class="col-lg-8">
                <div class="neo-animate-on-scroll">
                    <!-- Enhanced Main Image Display -->
                    <div class="image-showcase-card neo-card overflow-hidden mb-5 position-relative">
                        {% if annonce.voiture.image %}
                            <div class="position-relative image-container">
                                <img src="{{ asset('uploads/' ~ annonce.voiture.image) }}" 
                                     alt="{{ annonce.titre }}"
                                     class="showcase-image w-100"
                                     style="height: 550px; object-fit: cover;"
                                     id="mainCarImage">
                                
                                <!-- Enhanced Status Badges -->
                                <div class="position-absolute top-0 start-0 m-4 badge-container">
                                    {% if annonce.valider %}
                                        <span class="status-badge available-badge">
                                            <i class="fas fa-check-circle me-2"></i>Vérifié & Certifié
                                        </span>
                                    {% else %}
                                        <span class="status-badge pending-badge">
                                            <i class="fas fa-clock me-2"></i>En cours de validation
                                        </span>
                                    {% endif %}
                                </div>
                                
                                <!-- Enhanced Premium Badge -->
                                {% if annonce.voiture.prix and annonce.voiture.prix > 50000 %}
                                    <div class="position-absolute top-0 end-0 m-4">
                                        <span class="premium-badge-enhanced">
                                            <i class="fas fa-crown me-2"></i>COLLECTION PRESTIGE
                                        </span>
                                    </div>
                                {% endif %}
                                
                                <!-- Enhanced Zoom Overlay -->
                                <div class="zoom-overlay-enhanced position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                    <div class="zoom-button">
                                        <i class="fas fa-search-plus fa-2x"></i>
                                        <span class="d-block mt-2">Cliquer pour agrandir</span>
                                    </div>
                                </div>
                                
                                <!-- Image Counter -->
                                <div class="position-absolute bottom-0 end-0 m-4">
                                    <span class="image-counter">
                                        <i class="fas fa-images me-2"></i>1 / 1
                                    </span>
                                </div>
                            </div>
                        {% else %}
                            <div class="no-image-placeholder w-100 d-flex align-items-center justify-content-center" 
                                 style="height: 550px;">
                                <div class="text-center">
                                    <div class="no-image-icon-enhanced mb-4">
                                        <i class="fas fa-car fa-6x"></i>
                                    </div>
                                    <h4 class="text-muted mb-2">Aucune image disponible</h4>
                                    <p class="text-muted mb-0">L'image sera ajoutée prochainement</p>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- Enhanced Vehicle Info Cards -->
                    <div class="vehicle-info-grid mb-5">
                        <div class="row g-4">
                            <!-- Main Info Card -->
                            <div class="col-12">
                                <div class="main-info-card neo-card p-4">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start">
                                        <div class="vehicle-title-section flex-grow-1">
                                            <div class="brand-model-badge mb-3">
                                                <span class="brand-badge">{{ annonce.voiture.marque }}</span>
                                                <span class="model-badge">{{ annonce.voiture.modele }}</span>
                                            </div>
                                            <p class="vehicle-specs mb-0">
                                                {% if annonce.voiture.annee %}
                                                    <span class="spec-item">
                                                        <i class="fas fa-calendar text-primary me-2"></i>
                                                        <strong>{{ annonce.voiture.annee }}</strong>
                                                    </span>
                                                {% endif %}
                                                {% if annonce.voiture.kilometrage %}
                                                    <span class="spec-item">
                                                        <i class="fas fa-tachometer-alt text-warning me-2"></i>
                                                        <strong>{{ annonce.voiture.kilometrage|number_format(0, ',', ' ') }} km</strong>
                                                    </span>
                                                {% endif %}
                                                {% if annonce.voiture.puissanceFiscale %}
                                                    <span class="spec-item">
                                                        <i class="fas fa-bolt text-success me-2"></i>
                                                        <strong>{{ annonce.voiture.puissanceFiscale }} CV</strong>
                                                    </span>
                                                {% endif %}
                                            </p>
                                        </div>
                                        {% if annonce.voiture.prix %}
                                            <div class="price-section text-lg-end mt-3 mt-lg-0">
                                                <div class="price-display">
                                                    <span class="price-amount">{{ annonce.voiture.prix|number_format(0, ',', ' ') }} TND</span>
                                                    <span class="price-label">Prix négociable</span>
                                                </div>
                                            </div>
                                        {% else %}
                                            <div class="price-section text-lg-end mt-3 mt-lg-0">
                                                <div class="price-on-demand">
                                                    <span class="price-label">Prix sur demande</span>
                                                    <button class="contact-price-btn neo-btn neo-btn-primary mt-2">
                                                        <i class="fas fa-phone me-2"></i>Demander le prix
                                                    </button>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Enhanced Quick Specs Grid -->
                        <div class="row g-3 mt-2">
                            {% if annonce.voiture.annee %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Année</span>
                                            <span class="spec-value">{{ annonce.voiture.annee }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if annonce.voiture.kilometrage %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper bg-warning">
                                            <i class="fas fa-tachometer-alt"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Kilométrage</span>
                                            <span class="spec-value">{{ annonce.voiture.kilometrage|number_format(0, ',', ' ') }} km</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if annonce.voiture.carburant %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper bg-success">
                                            <i class="fas fa-gas-pump"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Carburant</span>
                                            <span class="spec-value">{{ annonce.voiture.carburant }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            {% if annonce.voiture.boiteVitesse %}
                                <div class="col-6 col-lg-3">
                                    <div class="quick-spec-card">
                                        <div class="spec-icon-wrapper bg-info">
                                            <i class="fas fa-cog"></i>
                                        </div>
                                        <div class="spec-details">
                                            <span class="spec-label">Transmission</span>
                                            <span class="spec-value">{{ annonce.voiture.boiteVitesse }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enhanced Sidebar -->
            <div class="col-lg-4">
                <div class="neo-animate-on-scroll" style="animation-delay: 0.2s;">
                    <!-- Enhanced Contact Card with Glass Effect -->
                    <div class="contact-card-enhanced mb-4">
                        <div class="contact-card-header">
                            <h3 class="contact-title">
                                <i class="fas fa-phone-alt me-2"></i>Contactez le Vendeur
                            </h3>
                            <div class="seller-rating">
                                <div class="stars">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                </div>
                                <span>Vendeur vérifié</span>
                            </div>
                        </div>
                        
                        <div class="contact-actions">
                            <button class="contact-btn-primary" onclick="callSeller()">
                                <i class="fas fa-phone me-2"></i>Appeler Maintenant
                                <div class="btn-glow"></div>
                            </button>
                            <button class="contact-btn-secondary" onclick="emailSeller()">
                                <i class="fas fa-envelope me-2"></i>Envoyer un Email
                            </button>
                            <button class="contact-btn-secondary" onclick="whatsappSeller()">
                                <i class="fab fa-whatsapp me-2"></i>WhatsApp
                            </button>
                        </div>
                        
                        <div class="seller-trust-badge">
                            <i class="fas fa-shield-check me-2"></i>
                            <span>Vendeur Certifié & Vérifié</span>
                        </div>
                    </div>

                    <!-- Enhanced Related Announcement Card -->
                    <div class="announcement-card mb-4 position-relative">
                        <div class="gradient-bg"></div>
                        <div class="card-body text-white text-center position-relative p-4">
                            <div class="announcement-icon mb-3">
                                <i class="fas fa-bullhorn fa-2x"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Créer une voiture </h4>
                            <p class="mb-4 opacity-90"> Créez votre propre voiture maintenant !</p>
                            <a href="{{ path('voiture_add') }}" class="announcement-btn">
                                <i class="fas fa-plus me-2"></i>Créer une voiture
                            </a>
                        </div>
                    </div>

                    <!-- Enhanced QR Code Card -->
                    <div class="qr-card-enhanced mb-4">
                        <div class="qr-card-header">
                            <h4 class="qr-title">
                                <i class="fas fa-qrcode me-2"></i>Code QR - Contact
                            </h4>
                        </div>
                        
                        <div class="qr-content">
                            <div class="qr-code-container">
                                <img src="{{ qrCode }}" alt="QR Code pour {{ annonce.titre }}" class="qr-code-image">
                                <div class="qr-overlay">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                            </div>
                            
                            <div class="qr-info">
                                <h5 class="qr-subtitle">Scannez pour ajouter le contact</h5>
                                <div class="qr-details">
                                    <div class="qr-detail-item">
                                        <i class="fas fa-building me-2"></i>Neo Cars
                                    </div>
                                    <div class="qr-detail-item">
                                        <i class="fas fa-car me-2"></i>{{ annonce.titre }}
                                    </div>
                                    <div class="qr-detail-item">
                                        <i class="fas fa-cog me-2"></i>{{ annonce.voiture.marque }} {{ annonce.voiture.modele }}
                                    </div>
                                    {% if annonce.voiture.prix %}
                                        <div class="qr-detail-item">
                                            <i class="fas fa-tag me-2"></i>{{ annonce.voiture.prix|number_format(0, ',', ' ') }} TND
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Share Card -->
                    <div class="share-card-enhanced">
                        <div class="share-header">
                            <h4 class="share-title">
                                <i class="fas fa-share-alt me-2"></i>Partager l'Annonce
                            </h4>
                        </div>
                        
                        <div class="share-buttons">
                            <button class="share-btn facebook" onclick="shareOnFacebook()">
                                <i class="fab fa-facebook-f"></i>
                                <span>Facebook</span>
                            </button>
                            <button class="share-btn twitter" onclick="shareOnTwitter()">
                                <i class="fab fa-twitter"></i>
                                <span>Twitter</span>
                            </button>
                            <button class="share-btn whatsapp" onclick="shareOnWhatsApp()">
                                <i class="fab fa-whatsapp"></i>
                                <span>WhatsApp</span>
                            </button>
                            <button class="share-btn copy" onclick="copyToClipboard('{{ app.request.uri }}')">
                                <i class="fas fa-copy"></i>
                                <span>Copier</span>
                            </button>
                        </div>
                        
                        <div class="share-url">
                            <input type="text" value="{{ app.request.uri }}" readonly class="share-url-input" id="shareUrl">
                            <button class="share-url-copy" onclick="copyToClipboard('{{ app.request.uri }}')">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Neo Detailed Specifications Section -->
<section class="neo-section" style="background: var(--neo-gray-50);">
    <div class="neo-container">
        <div class="row g-5">
            <!-- Technical Specifications -->
            <div class="col-lg-8">
                <div class="neo-animate-on-scroll">
                    <div class="neo-card p-4 mb-4">
                        <h3 class="neo-heading-2 mb-4">
                            <i class="fas fa-cog text-primary me-2"></i>Spécifications Techniques
                        </h3>
                        <div class="row g-4">
                            {% if annonce.voiture.puissanceFiscale %}
                                <div class="col-md-6">
                                    <div class="spec-item">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="spec-icon">
                                                <i class="fas fa-bolt"></i>
                                            </div>
                                            <div>
                                                <div class="neo-body-small text-muted">Puissance Fiscale</div>
                                                <div class="neo-heading-3">{{ annonce.voiture.puissanceFiscale }} CV</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if annonce.voiture.cylindree %}
                                <div class="col-md-6">
                                    <div class="spec-item">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="spec-icon">
                                                <i class="fas fa-tachometer-alt"></i>
                                            </div>
                                            <div>
                                                <div class="neo-body-small text-muted">Cylindrée</div>
                                                <div class="neo-heading-3">{{ annonce.voiture.cylindree }}</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if annonce.voiture.nombrePortes %}
                                <div class="col-md-6">
                                    <div class="spec-item">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="spec-icon">
                                                <i class="fas fa-door-open"></i>
                                            </div>
                                            <div>
                                                <div class="neo-body-small text-muted">Nombre de Portes</div>
                                                <div class="neo-heading-3">{{ annonce.voiture.nombrePortes }} portes</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="col-md-6">
                                <div class="spec-item">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="spec-icon">
                                            <i class="fas fa-car"></i>
                                        </div>
                                        <div>
                                            <div class="neo-body-small text-muted">Type de Véhicule</div>
                                            <div class="neo-heading-3">{{ annonce.voiture.marque }} {{ annonce.voiture.modele }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description Section -->
                    <div class="neo-card p-4">
                        <h3 class="neo-heading-2 mb-4">
                            <i class="fas fa-file-alt text-primary me-2"></i>Description du Véhicule
                        </h3>
                        <div class="neo-body text-muted" style="line-height: 1.8;">
                            {% if annonce.description %}
                                <p>{{ annonce.description|nl2br }}</p>
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="fas fa-info-circle fs-2 text-muted mb-3"></i>
                                    <p class="neo-body text-muted">Aucune description détaillée n'a été fournie pour ce véhicule.</p>
                                    <p class="neo-body-small text-muted">Contactez le vendeur pour plus d'informations.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Information -->
            <div class="col-lg-4">
                <div class="neo-animate-on-scroll" style="animation-delay: 0.3s;">
                    <!-- Safety & Security -->
                    <div class="neo-card p-4 mb-4">
                        <h4 class="neo-heading-3 mb-3">
                            <i class="fas fa-shield-alt text-success me-2"></i>Sécurité & Garanties
                        </h4>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Véhicule inspecté</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Historique vérifié</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Vendeur certifié</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="neo-body-small">Support client 24/7</span>
                            </div>
                        </div>
                    </div>

                    <!-- Financing Options -->
                    <div class="neo-card p-4">
                        <h4 class="neo-heading-3 mb-3">
                            <i class="fas fa-calculator text-warning me-2"></i>Options de Financement
                        </h4>
                        <div class="d-flex flex-column gap-3">
                            <div class="neo-glass p-3 rounded-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="neo-body-small">Paiement comptant</span>
                                    <i class="fas fa-check text-success"></i>
                                </div>
                            </div>
                            <div class="neo-glass p-3 rounded-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="neo-body-small">Crédit auto</span>
                                    <i class="fas fa-check text-success"></i>
                                </div>
                            </div>
                            <div class="neo-glass p-3 rounded-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="neo-body-small">Leasing</span>
                                    <i class="fas fa-check text-success"></i>
                                </div>
                            </div>
                        </div>
                        <a href="#" class="neo-btn neo-btn-primary w-100 mt-3">
                            <i class="fas fa-calculator me-2"></i>Simuler un Crédit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Neo Related Cars Section -->
<section class="neo-section">
    <div class="neo-container">
        <div class="text-center mb-5 neo-animate-on-scroll">
            <h2 class="neo-heading-1 mb-3">Véhicules Similaires</h2>
            <p class="neo-body-large text-muted">Découvrez d'autres véhicules qui pourraient vous intéresser</p>
        </div>
        
        <div class="row g-4">
            <!-- Related Car 1 -->
            <div class="col-lg-4 col-md-6 neo-animate-on-scroll">
                <div class="neo-card overflow-hidden">
                    <div class="position-relative">
                        <img src="{{ asset('front/images/featured-cars/fc1.png') }}" alt="Véhicule similaire" class="w-100" style="height: 220px; object-fit: cover;">
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge" style="background: var(--neo-gradient-success); padding: 0.5rem 1rem;">Disponible</span>
                        </div>
                    </div>
                    <div class="p-4">
                        <h4 class="neo-heading-3 mb-2">BMW Série 3</h4>
                        <p class="neo-body-small text-muted mb-3">2022 • 25,000 km • Automatique</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="neo-heading-3 text-primary">75,000 TND</span>
                        </div>
                        <a href="#" class="neo-btn neo-btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Voir Détails
                        </a>
                    </div>
                </div>
            </div>

            <!-- Related Car 2 -->
            <div class="col-lg-4 col-md-6 neo-animate-on-scroll" style="animation-delay: 0.2s;">
                <div class="neo-card overflow-hidden">
                    <div class="position-relative">
                        <img src="{{ asset('front/images/featured-cars/fc2.png') }}" alt="Véhicule similaire" class="w-100" style="height: 220px; object-fit: cover;">
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge" style="background: var(--neo-gradient-success); padding: 0.5rem 1rem;">Disponible</span>
                        </div>
                    </div>
                    <div class="p-4">
                        <h4 class="neo-heading-3 mb-2">Audi A4</h4>
                        <p class="neo-body-small text-muted mb-3">2021 • 35,000 km • Automatique</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="neo-heading-3 text-primary">68,000 TND</span>
                        </div>
                        <a href="#" class="neo-btn neo-btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Voir Détails
                        </a>
                    </div>
                </div>
            </div>

            <!-- Related Car 3 -->
            <div class="col-lg-4 col-md-6 neo-animate-on-scroll" style="animation-delay: 0.4s;">
                <div class="neo-card overflow-hidden">
                    <div class="position-relative">
